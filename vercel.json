{
  "crons": [
    {
      "path": "/api/post-daily",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/card.mjs": {
      "maxDuration": 30,
      "includeFiles": "assets/**"
    },
    "api/post-daily.mjs": {
      "maxDuration": 60,
      "includeFiles": "assets/**"
    },
    "api/report.mjs": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  }
}
